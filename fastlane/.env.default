## Project configuration

PROJECT_PATH=Riot.xcodeproj
SCHEME=Riot

MAIN_TARGET=Riot
SHARE_EXTENSION_TARGET=RiotShareExtension
SIRI_INTENTS_EXTENSION_TARGET=SiriIntents
NSE_TARGET=RiotNSE
BROADCAST_UPLOAD_EXTENSION_TARGET=BroadcastUploadExtension

MAIN_BUNDLE_ID=iq.teleiraq.app
SHARE_EXTENSION_BUNDLE_ID=iq.teleiraq.app.shareExtension
SIRI_INTENTS_EXTENSION_BUNDLE_ID=iq.teleiraq.app.SiriIntents
NSE_BUNDLE_ID=iq.teleiraq.app.nse
BROADCAST_UPLOAD_EXTENSION_BUNDLE_ID=iq.teleiraq.app.broadcastUploadExtension

## Build configuration

DERIVED_DATA_PATH=build
IPA_NAME=Riot
ARCHIVE_PATH=out/Riot.xcarchive
BUILD_OUTPUT_DIRECTORY=out
BUILD_LOG_DIRECTORY=build/Logs/Gym/

## Provisioning profiles files

PROVISIONING_PROFILES_PATH=./provisioning_profiles/

MAIN_PROVISIONING_PROFILE_FILENAME=main.mobileprovision
SHARE_EXTENSION_PROVISIONING_PROFILE_FILENAME=share_extension.mobileprovision
SIRI_INTENTS_EXTENSION_PROVISIONING_PROFILE_FILENAME=siri_intents.mobileprovision
NSE_PROVISIONING_PROFILE_FILENAME=nse.mobileprovision
BROADCAST_UPLOAD_EXTENSION_PROVISIONING_PROFILE_FILENAME=broadcast_upload_extension.mobileprovision

## App Store code signing

APPSTORE_CODESIGNING_IDENTITY=
APPSTORE_SIGNING_CERTIFICATE=

APPSTORE_MAIN_PROVISIONING_PROFILE_SPECIFIER=
APPSTORE_SHARE_EXTENSION_PROVISIONING_PROFILE_SPECIFIER=
APPSTORE_SIRI_INTENTS_EXTENSION_PROVISIONING_PROFILE_SPECIFIER=
APPSTORE_NSE_PROVISIONING_PROFILE_SPECIFIER=
APPSTORE_BROADCAST_UPLOAD_EXTENSION_PROVISIONING_PROFILE_SPECIFIER=

## Ad-Hoc code signing

ADHOC_MAIN_PROVISIONING_PROFILE_SPECIFIER=
ADHOC_SHARE_EXTENSION_PROVISIONING_PROFILE_SPECIFIER=
ADHOC_SIRI_INTENTS_EXTENSION_PROVISIONING_PROFILE_SPECIFIER=
ADHOC_NSE_PROVISIONING_PROFILE_SPECIFIER=
ADHOC_BROADCAST_UPLOAD_EXTENSION_PROVISIONING_PROFILE_SPECIFIER=

## Account information

TEAM_ID=
